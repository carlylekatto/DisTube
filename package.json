{
  "name": "@kattowo/distube",
  "version": "6.0.0",
  "description": "A powerful Discord.js module for simplifying music commands and effortless playback of various sources with integrated audio filters.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "directories": {
    "lib": "src",
    "test": "tests"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "vitest run",
    "docs": "typedoc",
    "lint": "biome ci .",
    "lint:fix": "biome check --write --unsafe",
    "format": "biome format --write",
    "build": "tsup",
    "type": "tsc --noEmit",
    "update": "bun upgrade",
    "prepare": "husky",
    "prepublishOnly": "bun run lint && bun run test",
    "prepack": "bun run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carlylekatto/DisTube.git"
  },
  "keywords": [
    "youtube",
    "music",
    "discord",
    "discordjs",
    "bot",
    "distube",
    "queue",
    "musicbot",
    "discord-music-bot",
    "music-bot",
    "discord-js"
  ],
  "author": {
    "name": "carlylekatto",
    "url": "https://github.com/carlylekatto"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/carlylekatto/DisTube/issues"
  },
  "homepage": "https://carlylekatto.github.io/distube-website/",
  "dependencies": {
    "tiny-typed-emitter": "^2.1.0",
    "undici": "^8.12.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.19.2",
    "@types/node": "^26.6.5",
    "@types/tough-cookie": "^4.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "discord-api-types": "^0.38.57",
    "discord.js": "^14.27.0",
    "esbuild-plugin-version-injector": "^1.2.1",
    "husky": "^9.1.7",
    "nano-staged": "^1.0.2",
    "tsup": "^9.0.0",
    "typedoc": "^0.28.20",
    "typedoc-material-theme": "^1.4.1",
    "typedoc-plugin-extras": "^4.0.1",
    "typescript": "^6.0.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "@discordjs/voice": ">=0.19.1",
    "discord.js": "14"
  },
  "nano-staged": {
    "*.{ts,js,json}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "trustedDependencies": [
    "@discordjs/opus",
    "esbuild"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
